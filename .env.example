# FastAPI Server Configuration
PORT=8000
ENVIRONMENT=development

# Supabase (PostgreSQL) - Uses the exact same database as Node.js backend
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Redis (Sessions, Caching, Rate Limiting)
REDIS_URL=redis://127.0.0.1:6379

# Meta WhatsApp Cloud API
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
VERIFY_TOKEN=connectify_verify_token

# WasenderAPI (set WHATSAPP_PROVIDER=wasender to enable)
WASENDER_API_KEY=
WASENDER_WEBHOOK_SECRET=

# Google Gemini AI (Natural Language Intent Parsing)
GEMINI_API_KEY=

# Paystack (Payments & Escrow Transfers)
PAYSTACK_SECRET_KEY=
