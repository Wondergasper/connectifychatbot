# FastAPI Server Configuration
PORT=8000
ENVIRONMENT=development

# Supabase (PostgreSQL) - Uses the exact same database as Node.js backend
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Redis (Sessions, Caching, Rate Limiting)
REDIS_URL=redis://127.0.0.1:6379

# Meta WhatsApp Cloud API
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
VERIFY_TOKEN=connectify_verify_token

# WasenderAPI (set WHATSAPP_PROVIDER=wasender to enable)
WASENDER_API_KEY=
WASENDER_WEBHOOK_SECRET=
WASENDER_QUEUE_DB=data/wasender.sqlite3
# Paid with account protection: 5 seconds. Trial: set to 60 seconds.
WASENDER_SEND_INTERVAL_SECONDS=5
WASENDER_INBOX_WORKERS=4

# Google Gemini AI (Natural Language Intent Parsing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Paystack (Payments & Escrow Transfers)
PAYSTACK_SECRET_KEY=
